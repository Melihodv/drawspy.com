# ─── DrawSpy Server Environment Variables ────────────────────────────────────
# Copy to apps/server/.env (never commit!)

# Server port
PORT=3001

# Allowed frontend origin (for CORS)
CLIENT_URL=https://drawspy.com

# Node environment
NODE_ENV=production

# ─── Optional: Supabase (for persistent rooms/leaderboards) ──────────────────
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/drawspy
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# ─── Optional: Upstash Redis (for multi-instance Socket.IO adapter) ──────────
# UPSTASH_REDIS_URL=https://[id].upstash.io
# UPSTASH_REDIS_TOKEN=AX...
